# Copy to .env (never commit .env). All variables are optional - every project runs offline
# on synthetic demo data with no keys.

# --- Crypto Market Intelligence ---
# Optional CoinGecko demo API key, only for `python pipeline.py --source coingecko`
COINGECKO_API_KEY=
CRYPTO_DB_PATH=
CRYPTO_SEED=42
# Last day of synthetic history (YYYY-MM-DD); default = yesterday (UTC)
CRYPTO_AS_OF=

# --- Retail & E-commerce Analytics ---
RETAIL_DB_PATH=
RETAIL_SEED=42
RETAIL_AS_OF=

# --- Supply Chain & Inventory Analytics ---
SUPPLY_DB_PATH=
SUPPLY_SEED=42
SUPPLY_AS_OF=
