table data_quality_checks
    column table
        dataType: string
        summarizeBy: none
        sourceColumn: table

    column rows
        dataType: int64
        summarizeBy: none
        sourceColumn: rows

    column duplicate_primary_keys
        dataType: int64
        summarizeBy: none
        sourceColumn: duplicate_primary_keys

    column missing_primary_keys
        dataType: int64
        summarizeBy: none
        sourceColumn: missing_primary_keys

    partition data_quality_checks = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents("C:\\Users\\dabas\\Downloads\\analytics-portfolio-github-clean\\analytics-portfolio\\ucompare-insurance-analytics\\outputs\\data_quality_checks.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"table", type text}, {"rows", Int64.Type}, {"duplicate_primary_keys", Int64.Type}, {"missing_primary_keys", Int64.Type}} , "en-IE")
            in
                ChangedTypes


    measure 'Total Customers' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Unique Customers")
        formatString: "#,0"

    measure 'Quote Requests' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Quote Requests")
        formatString: "#,0"

    measure 'Submitted Requests' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Submitted Quote Requests")
        formatString: "#,0"

    measure 'Provider Quotes Returned' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Provider Quotes Returned")
        formatString: "#,0"

    measure 'Confirmed Purchases' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Confirmed Purchases")
        formatString: "#,0"

    measure 'Gross Premium EUR' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Gross Premium EUR")
        formatString: "€#,0.00"

    measure 'Earned Commission EUR' = CALCULATE(MAX(executive_kpis[value]), executive_kpis[metric] = "Earned Commission EUR")
        formatString: "€#,0.00"

    measure 'Purchase Conversion Rate' = DIVIDE([Confirmed Purchases], [Quote Requests])
        formatString: "0.0%"

    measure 'Quote Submission Rate' = DIVIDE([Submitted Requests], [Quote Requests])
        formatString: "0.0%"

    measure 'Returned Quote Rate' = DIVIDE([Provider Quotes Returned], [Submitted Requests])
        formatString: "0.0%"

    measure 'Product Quote Requests' = SUM(product_performance[quote_requests])
        formatString: "#,0"

    measure 'Product Purchases' = SUM(product_performance[confirmed_purchases])
        formatString: "#,0"

    measure 'Product Gross Premium EUR' = SUM(product_performance[gross_premium_eur])
        formatString: "€#,0.00"

    measure 'Product Commission EUR' = SUM(product_performance[earned_commission_eur])
        formatString: "€#,0.00"

    measure 'Monthly Quote Requests' = SUM(monthly_performance[quote_requests])
        formatString: "#,0"

    measure 'Monthly Purchases' = SUM(monthly_performance[confirmed_purchases])
        formatString: "#,0"

    measure 'Monthly Gross Premium EUR' = SUM(monthly_performance[gross_premium_eur])
        formatString: "€#,0.00"

    measure 'Provider Quotes' = SUM(provider_performance[quotes_returned])
        formatString: "#,0"

    measure 'Provider Purchases' = SUM(provider_performance[confirmed_purchases])
        formatString: "#,0"

    measure 'Provider Premium EUR' = SUM(provider_performance[gross_premium_eur])
        formatString: "€#,0.00"

    measure 'Priority Provider Quotes' = SUM(travel_priority_providers[quotes_returned])
        formatString: "#,0"

    measure 'Priority Provider Purchases' = SUM(travel_priority_providers[confirmed_purchases])
        formatString: "#,0"

    measure 'Priority Provider Premium EUR' = SUM(travel_priority_providers[gross_premium_eur])
        formatString: "€#,0.00"
