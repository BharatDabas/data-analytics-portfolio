model Model
    culture: en-IN
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-IN
    valueFilterBehavior: independent
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo en-IN

table executive_kpis
    column metric
        dataType: string
        summarizeBy: none
        sourceColumn: metric

    column value
        dataType: double
        summarizeBy: none
        sourceColumn: value

    partition executive_kpis = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents("C:\\Users\\dabas\\Downloads\\analytics-portfolio-github-clean\\analytics-portfolio\\ucompare-insurance-analytics\\outputs\\executive_kpis.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"metric", type text}, {"value", type number}} , "en-IE")
            in
                ChangedTypes


table monthly_performance
    column month
        dataType: string
        summarizeBy: none
        sourceColumn: month

    column insurance_type
        dataType: string
        summarizeBy: none
        sourceColumn: insurance_type

    column quote_requests
        dataType: int64
        summarizeBy: none
        sourceColumn: quote_requests

    column confirmed_purchases
        dataType: int64
        summarizeBy: none
        sourceColumn: confirmed_purchases

    column gross_premium_eur
        dataType: double
        summarizeBy: none
        sourceColumn: gross_premium_eur

    partition monthly_performance = m
        mode: import
        source =
            let
                Source = Csv.Document(File.Contents("C:\\Users\\dabas\\Downloads\\analytics-portfolio-github-clean\\analytics-portfolio\\ucompare-insurance-analytics\\outputs\\monthly_performance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
                ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"month", type text}, {"insurance_type", type text}, {"quote_requests", Int64.Type}, {"confirmed_purchases", Int64.Type}, {"gross_premium_eur", type number}} , "en-IE")
            in
                ChangedTypes


